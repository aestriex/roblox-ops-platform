<div class="flex flex-col items-center justify-center text-center py-24 space-y-4">
  <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center">
    <%= lucide_icon "circle-check", class: "w-8 h-8 text-primary" %>
  </div>

  <h1 class="text-2xl font-bold text-foreground">Application Submitted!</h1>

  <p class="text-muted-foreground max-w-md">
    Thank you for applying to <span class="font-medium text-foreground"><%= @job_posting.title %></span>.
    Your response has been recorded<% if @application&.submitted_at %> on <%= @application.submitted_at.strftime("%B %-d, %Y") %><% end %>.
  </p>
</div>
