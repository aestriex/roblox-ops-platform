<div class="grid grid-cols-3 gap-8">
  <div class="col-span-1 space-y-8 sticky top-8 self-start">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold text-foreground">
        <%= @job_posting.title %>
      </h1>

      <p class="text-sm text-muted-foreground">
        <%= @job_posting.department %>
      </p>

      <p class="text-sm text-foreground"><%= @job_posting.description %></p>
    </div>

    <div>
      <% @sections.each_with_index do |section, index| %>
        <div class="flex items-start gap-3">
          <div class="flex flex-col items-center">
            <div
              class="
                w-6 h-6 rounded-full flex items-center justify-center text-xs font-medium leading-none
                <%= index == @current_index ? "bg-primary text-primary-foreground" : (index < @current_index ? "bg-primary/20 text-primary" : "bg-muted text-muted-foreground") %>
              "
            >
              <%= index + 1 %>
            </div>

            <% unless index == @sections.size - 1 %>
              <div class="w-px h-8 <%= index < @current_index ? "bg-primary/40" : "bg-border" %>"></div>
            <% end %>
          </div>

          <p class="text-sm mt-0.5 <%= index == @current_index ? "text-foreground font-medium" : "text-muted-foreground" %>">
            <%= section.title %>
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="col-span-2 space-y-6">
    <% if @current_index == 0 %>
      <div
        class="
          bg-primary/5 border border-primary/10 rounded-lg p-4 text-sm
          text-foreground
        "
      >
        <p class="font-medium mb-2">Welcome!</p>

        <p class="text-muted-foreground">
          Thanks for your interest in Studio Proviso's
          <%= @job_posting.title %> application. Take your time filling out the
          sections below — your progress is saved automatically as you go, so
          feel free to leave and come back anytime.
        </p>
      </div>
    <% end %>

    <h2 class="text-xl font-semibold text-foreground"><%= @section.title %></h2>

    <% if flash[:alert] %>
      <div
        class="
          text-sm text-destructive bg-destructive/10 border
          border-destructive/20 rounded-md px-4 py-2
        "
      >
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: apply_path(slug: @job_posting.slug, section_position: @current_index + 1), method: :patch, multipart: true, class: "space-y-6" do |form| %>
      <% @section.questions.order(:position).each do |question| %>
        <% existing_answer = @answers[question.id] %>

        <div>
          <div class="flex items-center gap-1 mb-2">
            <label class="block font-medium text-foreground"><%= question.label %></label>

            <% if question.required %>
              <span class="text-xs text-destructive">*</span>
            <% end %>
          </div>

          <% field_name = "answers[#{question.id}]" %>

          <% case question.question_type %>
          <% when "short_text" %>
            <%= text_field_tag field_name, existing_answer&.value, class: "w-full max-w-md border border-input rounded-md px-4 py-2 bg-background" %>
          <% when "long_text" %>
            <%= text_area_tag field_name, existing_answer&.value, rows: 4, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
          <% when "email" %>
            <%= email_field_tag field_name, existing_answer&.value, class: "w-full max-w-md border border-input rounded-md px-4 py-2 bg-background" %>
          <% when "link" %>
            <%= url_field_tag field_name, existing_answer&.value, class: "w-full max-w-md border border-input rounded-md px-4 py-2 bg-background" %>
          <% when "file_upload" %>
            <div data-controller="file-upload">
              <div
                data-file-upload-target="dropzone"
                data-action="click->file-upload#open"
                class="flex items-center justify-center gap-2 px-6 py-8 border border-dashed border-input rounded-md text-sm text-muted-foreground w-full max-w-md cursor-pointer transition-colors duration-150 hover:border-primary/50"
              >
                <%= lucide_icon "paperclip", class: "w-4 h-4" %>
                <span data-file-upload-target="label">
                    <%= existing_answer&.file&.attached? ? existing_answer.file.filename : "Click to upload or drag and drop" %>
                </span>
              </div>

              <%= file_field_tag field_name, class: "hidden", data: { file_upload_target: "input", action: "file-upload#change" } %>
            </div>
          <% when "checkbox" %>
            <div class="space-y-2">
              <% question.options_list.each do |option| %>
                <%= render_checkbox label: option, name: "#{field_name}[]", value: option, id: "question_#{question.id}_#{option.parameterize}", checked: existing_answer&.value.include?(option) %>
              <% end %>
            </div>
          <% when "radio" %>
            <div class="space-y-2">
              <% question.options_list.each do |option| %>
                <label class="flex items-center gap-2 text-sm text-foreground">
                  <%= radio_button_tag field_name, option, existing_answer&.value == option, id: "question_#{question.id}_#{option.parameterize}" %>
                  <%= option %>
                </label>
              <% end %>
            </div>
          <% when "dropdown" %>
            <%= select_tag field_name, options_for_select(question.options_list, existing_answer&.value), include_blank: "Select an option", class: "w-full max-w-md border border-input rounded-md px-4 py-2 bg-background" %>
          <% end %>
        </div>
      <% end %>

      <div class="flex justify-between pt-6 border-t border-border">
        <% if @current_index > 0 %>
          <%= link_to "Back", apply_path(slug: @job_posting.slug, section_position: @current_index), class: "px-4 py-2 rounded-md border border-input text-sm font-medium hover:bg-accent" %>
        <% else %>
          <div></div>
        <% end %>

        <% if @current_index < @sections.size - 1 %>
          <%= form.submit "Next", class: "px-4 py-2 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 cursor-pointer" %>
        <% else %>
          <%= form.submit "Submit Application", class: "px-4 py-2 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 cursor-pointer" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
