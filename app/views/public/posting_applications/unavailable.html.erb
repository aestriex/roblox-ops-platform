<div class="flex flex-col items-center justify-center text-center py-24 space-y-4">
  <div class="w-16 h-16 rounded-full bg-muted flex items-center justify-center">
    <%= lucide_icon "clock", class: "w-8 h-8 text-muted-foreground" %>
  </div>

  <h1 class="text-2xl font-bold text-foreground">This posting isn't accepting applications</h1>

  <p class="text-muted-foreground max-w-md">
    <span class="font-medium text-foreground"><%= @job_posting.title %></span> is not currently open.
    Please check back later or reach out to <%= Configuration.instance.org_name %> directly.
  </p>
</div>
