<%= turbo_frame_tag dom_id(@section, :new_question) do %>
<%= form_with model: @question, url: hiring_job_posting_section_questions_path(@job_posting, @section), class: "space-y-4 p-4 border border-border rounded-lg", data: { controller: "toggle-visibility", "toggle-visibility-shown-types-value": Question::OPTION_TYPES.to_json } do |form| %>    <div>
      <%= form.label :label, "Question Text", class: "block font-medium text-foreground mb-1" %>
      <%= form.text_field :label, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
    </div>

    <div>
      <%= form.label :question_type, "Question Type", class: "block font-medium text-foreground mb-1" %>
      <%= form.select :question_type, Question::QUESTION_TYPES, {}, {
            class: "w-full border border-input rounded-md px-4 py-2 bg-background",
            data: { action: "change->toggle-visibility#check", "toggle-visibility-target": "select" }
          } %>
    </div>

    <div data-toggle-visibility-target="optionsPanel" class="<%= "hidden" unless @question.has_options? %>">
      <%= form.label :options, "Options (one per line)", class: "block font-medium text-foreground mb-1" %>
      <%= form.text_area :options, rows: 4, class: "w-full border border-input rounded-md px-4 py-2 bg-background", placeholder: "Option 1\nOption 2\nOption 3" %>
    </div>

    <div class="flex items-center gap-2">
      <%= render_checkbox(label: "Required", name: "question[required]", checked: @question.required) %>
    </div>

    <%= render_button "Add Question", type: :submit %>
  <% end %>
<% end %>