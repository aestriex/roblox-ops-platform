<div class="max-w-3xl mx-auto space-y-8">
    <div>
        <div class="flex items-center gap-3">
            <%= image_tag @posting_application.user.display_avatar_url, class: "w-10 h-10 rounded-full" %>

            <div>
            <h1 class="text-xl font-bold text-foreground">
                <%= @posting_application.user.display_name %>
            </h1>

            <p class="text-sm text-muted-foreground">
                Applied to <%= @job_posting.title %>
                <% if @posting_application.submitted_at %>
                on <%= @posting_application.submitted_at.strftime("%B %-d, %Y") %>
                <% end %>
            </p>
            </div>
        </div>

        <%= render_alert_dialog do %>
          <% alert_dialog_trigger do %>
            <%= render_button variant: :ghost, class: "ml-auto transition-all duration-100" do %>
              <%= lucide_icon "trash", class: "w-4 h-4 text-destructive" %>
            <% end %>
          <% end %>

          <% alert_dialog_content do %>
            <h2 class="text-lg font-semibold text-foreground mb-2">Delete this submission?</h2>
            <p class="text-sm text-muted-foreground">This action cannot be undone.</p>
          <% end %>

          <% alert_dialog_cancel do %>
            <%= render_button "Cancel", variant: :outline %>
          <% end %>

          <% alert_dialog_continue do %>
            <%= button_to "Delete", hiring_job_posting_posting_application_path(@job_posting, @posting_application), method: :delete, form: { data: { turbo_frame: "_top" } }, class: "px-4 py-2 rounded-md bg-destructive text-destructive-foreground hover:opacity-90 text-sm font-medium" %>
          <% end %>
        <% end %>
    </div>

  <% @job_posting.sections.order(:position).each do |section| %>
    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-foreground border-b border-border pb-2">
        <%= section.title %>
      </h2>

      <% section.questions.order(:position).each do |question| %>
        <% answer = @posting_application.answers.find_by(question: question) %>

        <div>
          <p class="text-sm font-medium text-foreground mb-1">
            <%= question.label %>
          </p>

          <% if answer.nil? || (answer.value.blank? && !answer.file.attached?) %>
            <p class="text-sm text-muted-foreground italic">
              No answer provided
            </p>
          <% elsif answer.file.attached? %>
            <%= link_to rails_blob_path(answer.file, disposition: "attachment"), class: "inline-flex items-center gap-2 px-3 py-2 border border-border rounded-md text-sm text-foreground hover:bg-accent w-fit" do %>
              <%= lucide_icon "paperclip", class: "w-4 h-4 text-muted-foreground" %>
              <%= answer.file.filename %>

              <span class="text-xs text-muted-foreground">(<%= number_to_human_size(answer.file.byte_size) %>)</span>
            <% end %>
          <% elsif answer.value.is_a?(Array) %>
            <p class="text-sm text-foreground">
              <%= answer.value.join(", ") %>
            </p>
          <% else %>
            <p class="text-sm text-foreground whitespace-pre-line"><%= answer.value %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
