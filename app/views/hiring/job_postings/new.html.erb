<div class="max-w-2xl mx-auto px-6 py-12">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">New Job Posting</h1>

  <%= form_with model: @job_posting, class: "space-y-6 text-lg" do |form| %>
    <div>
      <%= form.label :title, class: "block font-medium text-gray-900 mb-1" %>
        <%= form.text_field :title, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
    </div>

    <div>
      <%= form.label :description, class: "block font-medium text-gray-900 mb-1" %>
        <%= form.text_area :description, rows: 5, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
    </div>

    <div>
      <%= form.label :department, class: "block font-medium text-gray-900 mb-1" %>
        <%= form.text_field :department, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
    </div>

    <div>
      <%= form.label :status, class: "block font-medium text-gray-900 mb-1" %>
        <%= form.select :status, %w[draft open closed], {}, class: "w-full border border-gray-300 rounded-lg px-4 py-2"
          %>
    </div>

    <%= form.submit "Create Posting" ,
      class: "bg-pink-500 text-white font-semibold px-6 py-3 rounded-lg hover:rounded-3xl transition-all duration-300 cursor-pointer" %>
      <% end %>
</div>