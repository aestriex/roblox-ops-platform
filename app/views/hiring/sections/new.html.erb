<%= turbo_frame_tag "new_section" do %>
  <%= form_with model: @section, url: hiring_job_posting_sections_path(@job_posting), class: "space-y-4 p-4 border border-border rounded-lg" do |form| %>
    <div>
      <%= form.label :title, class: "block font-medium text-foreground mb-1" %>
      <%= form.text_field :title, class: "w-full border border-input rounded-md px-4 py-2 bg-background focus:ring-2 focus:outline-none focus:ring-accent duration-100" %>
    </div>
    <div>
      <%= form.label :position, class: "block font-medium text-foreground mb-1" %>
      <%= form.number_field :position, class: "w-full border border-input rounded-md px-4 py-2 bg-background focus:ring-2 focus:outline-none focus:ring-accent duration-100" %>
    </div>
    <%= render_button "Add Section", type: :submit %>
  <% end %>
<% end %>
