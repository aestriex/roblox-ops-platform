<div id="<%= dom_id(section) %>" data-id="<%= section.id %>" class="mt-8">
  <div class="flex items-center gap-2 mb-4">
    <%= lucide_icon "grip-vertical", class: "w-4 h-4 text-muted-foreground cursor-grab drag-handle" %>
    <h2 class="text-xl font-semibold text-foreground"><%= section.title %></h2>
  </div>

  <div id="<%= dom_id(section, :questions) %>"
     data-controller="sortable"
     data-sortable-url-value="<%= reorder_job_posting_section_questions_path(job_posting, section) %>">
    <% section.questions.order(:position).each do |question| %>
      <%= render "questions/question", question: question %>
    <% end %>
  </div>

  <div class="mt-3">
    <%= turbo_frame_tag dom_id(section, :new_question) do %>
        <%= render_button as: :link, href: new_job_posting_section_question_path(job_posting, section), variant: :secondary, draggable: false do %>
          <%= lucide_icon "plus", class: "w-4 h-4 mr-2" %> Add Question
        <% end %>
    <% end %>
  </div>
</div>
