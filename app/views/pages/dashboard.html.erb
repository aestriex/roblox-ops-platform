<div class="mx-auto space-y-8">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% @modules.each do |mod| %>
      <%= link_to mod[:path], class: "block p-6 border border-border rounded-lg hover:border-primary/50 transition-colors duration-150 space-y-4" do %>
        <div class="flex items-center gap-2">
          <%= lucide_icon mod[:icon], class: "w-5 h-5 text-muted-foreground" %>
          <h2 class="font-semibold text-foreground"><%= mod[:title] %></h2>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <% mod[:stats].each do |stat| %>
            <div>
              <p class="text-2xl font-bold text-foreground"><%= stat[:value] %></p>
              <p class="text-xs text-muted-foreground"><%= stat[:label] %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @modules.empty? %>
    <div class="text-center py-24 text-muted-foreground">
      <%= lucide_icon "package-open", class: "w-8 h-8 mx-auto mb-3" %>
      <p>All modules are currently disabled. Enable one in Configuration to get started.</p>
    </div>
  <% end %>
</div>
