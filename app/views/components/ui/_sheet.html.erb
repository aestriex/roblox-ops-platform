<div data-controller="ui--sheet" id="<%= options[:id] %>">
  <div data-action="click->ui--sheet#open"><%= content_for(:sheet_trigger) %></div>

  <%= render "components/ui/shared/backdrop", as: "modal" %>

  <div
    role="dialog"
    data-state="<%= options[:state] %>"
    data-ui--sheet-target="dialog"
    class="<%= tw("data-[state=closed]:hidden data-[state=open]:flex flex-col fixed z-50 bg-background shadow-lg
                  transition ease-in-out data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:duration-300
                  data-[state=open]:duration-500 inset-y-0 h-full border-l border-border",
                  "data-[state=closed]:slide-out-to-#{options[:direction]}
                  data-[state=open]:slide-in-from-#{options[:direction]}",
                  direction_class(options[:direction]), options[:width],
                  options[:class]) %>"
    tabindex="-1"
    style="pointer-events: auto">

    <div class="flex items-center gap-2 px-4 h-(--spacing-header) border-b border-border shrink-0" data-ui--sheet-target="header">
    <button type="button" data-action="click->ui--sheet#backOrClose" class="p-1 rounded-md hover:bg-accent">
        <svg data-ui--sheet-target="backIcon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
        <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
        </svg>
    </button>
      <div class="flex-1 min-w-0" data-ui--sheet-target="title"></div>
    </div>

    <div class="flex-1 overflow-y-auto" data-ui--sheet-target="content">
      <%= turbo_frame_tag "sheet_content_frame" %>
    </div>
  </div>
</div>
