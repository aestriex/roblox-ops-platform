<div data-controller="ui--date-picker" data-ui--date-picker-format-value="%b %-d, %Y" class="flex items-center gap-1">
  <%= tag.input(**input_attrs) %>

  <button type="button" data-ui--date-picker-target="toggle" aria-label="Open calendar"
    class="inline-flex items-center justify-center whitespace-nowrap rounded-md ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 w-9 shrink-0">
    <%= lucide_icon "calendar", class: "w-4 h-4" %>
  </button>

  <%= tag.input type: "hidden", name: name, id: id, value: value, data: { "ui--date-picker-target": "hidden" } %>
</div>
