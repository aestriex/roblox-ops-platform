<button
  type="button"
  role="tab"
  id="<%= options[:id] %>"
  data-ui--tabs-target="tab"
  data-state="<%= options[:state] %>"
  data-id="<%= options[:id] %>"
  class="inline-flex items-center gap-1.5 -mb-px px-1 py-3 text-sm font-medium border-b-2 border-transparent text-muted-foreground transition-colors duration-150 hover:text-foreground data-[state=active]:border-primary data-[state=active]:text-foreground cursor-pointer"
  tabindex="0"
  data-orientation="horizontal">
  <% if options[:icon] %>
    <%= lucide_icon options[:icon], class: "w-4 h-4" %>
  <% end %>
  <%= title %>
</button>
