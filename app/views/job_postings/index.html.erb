<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-bold text-foreground">Job Postings</h1>

  <%= render_dialog do %>
    <%= dialog_trigger do %>
      <%= render_button variant: :outline do %>
        <%= lucide_icon "plus", class: "w-4 h-4 mr-2" %> New Posting
      <% end %>
    <% end %>

    <%= dialog_content do %>
      <h2 class="text-lg font-semibold text-foreground mb-1">New Job Posting</h2>
      <p class="text-sm text-muted-foreground mb-6">Enter the initial details. You can add sections and questions after creating it.</p>

      <%= turbo_frame_tag "job_posting_dialog_form" do %>
        <%= render "job_postings/form", job_posting: JobPosting.new %>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= render_table do %>
  <%= table_head do %>
    <%= table_header "Title" %>
    <%= table_header "Department" %>
    <%= table_header "Status" %>
    <%= table_header "" %>
  <% end %>

  <%= table_body do %>
    <% @job_postings.each do |posting| %>
      <%= table_row class: "relative" do %>
        <%= table_column do %>
          <%= link_to posting.title, job_posting_path(posting), class: "after:absolute after:inset-0" %>
        <% end %>
        <%= table_column posting.department %>
        <%= table_column do %>
          <span class="px-2 py-1 rounded-full text-xs font-medium <%= posting.status_badge_classes %>">
            <%= posting.status.titleize %>
          </span>
        <% end %>
        <%= table_column do %>
          <div class="flex justify-end gap-1">
            <%= render_button as: :link, href: edit_job_posting_path(posting), variant: :ghost, class: "relative z-10" do %>
                <%= lucide_icon "pencil", class: "w-4 h-4" %>
            <% end %>

            <%= render_alert_dialog do %>
                <% alert_dialog_trigger do %>
                <%= render_button variant: :ghost do %>
                    <%= lucide_icon "trash", class: "w-4 h-4 text-destructive" %>
                <% end %>
                <% end %>

                <% alert_dialog_content do %>
                <h2 class="text-lg font-semibold text-foreground mb-2">
                    Delete this job posting?
                </h2>

                <p class="text-sm text-muted-foreground">This action cannot be undone.</p>
                <% end %>

                <% alert_dialog_cancel do %>
                <%= render_button "Cancel", variant: :outline %>
                <% end %>

                <% alert_dialog_continue do %>
                <%= button_to "Delete", job_posting_path(posting), method: :delete, form: { data: { turbo_frame: "_top" } }, class: "px-4 py-2 rounded-md bg-destructive text-destructive-foreground hover:opacity-90 text-sm font-medium z-500" %>
            <% end %>
          </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
