<div class="grid grid-cols-3 gap-8">
  <div class="col-span-1 space-y-6 sticky top-8 self-start z-10">
    <div class="p-4 rounded-lg space-y-3">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold text-foreground">
          <%= @job_posting.title %>
        </h1>

        <span class="px-2 py-1 rounded-full text-xs font-medium <%= @job_posting.status_badge_classes %>">
          <%= @job_posting.status.titleize %>
        </span>
      </div>

      <p class="text-sm text-muted-foreground">
        <%= @job_posting.department %>
      </p>

      <p class="text-sm text-foreground"><%= @job_posting.description %></p>
    </div>

    <div class="flex flex-row gap-2">
      <div class="flex-1">
        <% if @job_posting.status == "draft" %>
          <%= render_button "Publish", as: :link, href: update_status_job_posting_path(@job_posting, status: "open"), variant: :default, class: "w-full", data: { turbo_method: :patch } %>
        <% elsif @job_posting.status == "open" %>
          <%= render_button "Close Posting", as: :link, href: update_status_job_posting_path(@job_posting, status: "closed"), variant: :destructive, class: "w-full", data: { turbo_method: :patch } %>
        <% else %>
          <%= render_button "Reopen", as: :link, href: update_status_job_posting_path(@job_posting, status: "open"), variant: :default, class: "w-full", data: { turbo_method: :patch } %>
        <% end %>
      </div>

      <div class="flex-1">
        <%= render_dialog do %>
          <%= dialog_trigger do %>
            <%= render_button variant: :outline, class: "w-full" do %>
              <%= lucide_icon "pencil", class: "w-4 h-4 mr-2" %> Edit Details
            <% end %>
          <% end %>

          <%= dialog_content do %>
            <h2 class="text-lg font-semibold text-foreground mb-6">
              Edit Job Posting
            </h2>

            <%= turbo_frame_tag "job_posting_dialog_form" do %>
              <%= render "job_postings/form", job_posting: @job_posting %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="flex items-center justify-between p-4 border border-border rounded-lg">
      <div class="flex flex-col gap-1">
        <p class="text-sm font-medium text-foreground">Applications</p>
        <p class="text-sm text-muted-foreground">
          <%= @job_posting.posting_applications.where(status: "submitted").count %>
          submitted &nbsp;·&nbsp;
          <%= @job_posting.posting_applications.where(status: "in_progress").count %>
          in progress
        </p>
      </div>

      <%= render_button as: :link, href: job_posting_posting_applications_path(@job_posting), variant: :outline do %>
        View
        <%= lucide_icon "arrow-right", class: "w-4 h-4 ml-2" %>
      <% end %>
    </div>

    <div class="p-4 border border-border rounded-lg space-y-2">
      <p class="text-sm font-medium text-foreground">Sharing URL</p>

      <div class="flex items-center gap-2" data-controller="clipboard">
        <input
          data-clipboard-target="source"
          type="text"
          readonly
          value="<%= "#{request.base_url}/apply/#{@job_posting.slug}" %>"
          class="
            flex-1 text-xs border border-input rounded-md px-2 py-1.5
            bg-muted text-muted-foreground
          "
          autocomplete="off"
        >

        <%= render_button variant: :ghost, data: { action: "clipboard#copy" } do %>
          <%= lucide_icon "copy", class: "w-4 h-4", data: { clipboard_target: "copyIcon" } %>
          <%= lucide_icon "check", class: "w-4 h-4 hidden", data: { clipboard_target: "checkIcon" } %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-span-2 relative space-y-4">
    <div
      id="sections"
      data-controller="sortable"
      data-sortable-url-value="<%= reorder_job_posting_sections_path(@job_posting) %>"
    >
      <% @job_posting.sections.order(:position).each do |section| %>
        <%= render "sections/section", section: section, job_posting: @job_posting %>
      <% end %>
    </div>

    <%= turbo_frame_tag "new_section", data: { controller: "dismissible-frame" } do %>
      <%= render "sections/add_section_button", job_posting: @job_posting %>
    <% end %>
  </div>
</div>
