<%= form_with model: job_posting, url: job_posting.persisted? ? job_posting_path(job_posting) : job_postings_path, class: "space-y-4", data: { turbo_frame: "_top" } do |form| %>  <% if job_posting.errors.any? %>
    <div class="text-sm text-destructive space-y-1">
      <% job_posting.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <div class="flex gap-1">
      <%= form.label :title, class: "block font-medium text-foreground mb-1" %>
      <span class="text-xs text-destructive">*</span>
    </div>

    <%= form.text_field :title, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
  </div>

  <div>
    <div class="flex gap-1">
      <%= form.label :department, class: "block font-medium text-foreground mb-1" %>
      <span class="text-xs text-destructive">*</span>
    </div>

    <%= form.text_field :department, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
  </div>

  <div>
    <div class="flex gap-1">
      <%= form.label :description, class: "block font-medium text-foreground mb-1" %>
      <span class="text-xs text-destructive">*</span>
    </div>

    <%= form.text_area :description, rows: 3, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
  </div>

  <div>
    <%= form.label :status, class: "block font-medium text-foreground mb-1 hidden" %>
    <%= form.select :status, job_posting.persisted? ? job_posting.status : %w[draft], {}, class: "w-full border border-input rounded-md px-4 py-2 bg-background hidden" %>
  </div>

  <%= render_button job_posting.persisted? ? "Save Changes" : "Create Posting", type: :submit %>
<% end %>
