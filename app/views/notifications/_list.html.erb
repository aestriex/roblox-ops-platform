<div class="bg-background flex items-center justify-between px-2 py-1.5">
  <p class="text-sm font-medium text-foreground">Notifications</p>

  <div class="flex items-center gap-2">
    <%= render "notifications/mark_all_read", user: current_user %>

    <%= render_dialog do %>
      <% dialog_trigger do %>
        <button type="button" class="p-1 rounded-sm hover:bg-accent text-muted-foreground hover:text-foreground">
          <%= lucide_icon "settings", class: "w-3.5 h-3.5" %>
        </button>
      <% end %>
      <% dialog_content do %>
        <h2 class="text-lg font-semibold text-foreground mb-4">Notification Settings</h2>
        <%= render "notification_preferences/form" %>
      <% end %>
    <% end %>
  </div>
</div>

<%= render_separator class: "my-1" %>

<%= render "notifications/items", notifications: current_user.notifications.recent.limit(10) %>
