<!DOCTYPE html>
<html>

<head>
  <title>
    <%= content_for(:title) || "Apply — Studio Provisio" %>
  </title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <script>
    if (localStorage.theme === "dark" || (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
      document.documentElement.classList.add("dark");
    }
  </script>
</head>

<body class="bg-background text-foreground transition-all duration-300 antialiased" data-controller="theme">
  <header class="h-(--spacing-header) flex items-center px-8 border-b border-border">
    <span class="text-lg"><span class="font-semibold">Studio Proviso</span> Jobs</span>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-12">
    <%= yield %>
  </main>
</body>

</html>
