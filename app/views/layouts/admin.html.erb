<!DOCTYPE html>
<html>

<head>
  <title>
    <%= content_for(:title) || "Hiring Portal" %>
  </title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <script>
    if (localStorage.theme === "dark" || (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
      document.documentElement.classList.add("dark");
    }
  </script>
</head>

<body class="bg-background text-foreground transition-all duration-300 antialiased" data-controller="theme">
  <div class="flex h-screen">
    <aside class="w-64 border-r border-border bg-muted/40 flex flex-col">
      <div class="h-(--spacing-header) flex items-center px-4 border-b border-border">
        <span class="font-semibold text-lg">Studio Proviso</span>
      </div>

      <nav class="flex-1 p-4 space-y-1">
        <%= link_to root_path, class: "flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium tracking-tight hover:bg-accent hover:text-accent-foreground transition-all duration-300" do %>
          <%= lucide_icon "layout-dashboard" , class: "w-4 h-4" %>
            Dashboard
        <% end %>

        <%= link_to hiring_job_postings_path, class: "flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium tracking-tight hover:bg-accent hover:text-accent-foreground transition-all duration-300" do %>
          <%= lucide_icon "briefcase" , class: "w-4 h-4" %>
            Job Postings
        <% end %>

        <%= link_to admin_roles_path, class: "flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium tracking-tight hover:bg-accent hover:text-accent-foreground transition-all duration-300" do %>
          <%= lucide_icon "key" , class: "w-4 h-4" %>
            Role Management
        <% end %>

        <%= link_to admin_users_path, class: "flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium tracking-tight hover:bg-accent hover:text-accent-foreground transition-all duration-300" do %>
          <%= lucide_icon "user" , class: "w-4 h-4" %>
            User Management
        <% end %>
      </nav>
      <div class="p-4 border-t border-border text-sm flex flex-row justify-between items-center">
        <div class="flex items-center gap-2">
          <%= image_tag current_user.display_avatar_url, class: "w-8 h-8 rounded-full" %>
            <p class="text-foreground truncate">
              <%= current_user.display_name %>
            </p>
        </div>
        <div class="relative" data-controller="dropdown">
          <button data-action="click->dropdown#toggle" class="p-1 rounded-md hover:bg-accent">
            <%= lucide_icon "more-vertical", class: "w-5 h-5" %>
          </button>

          <div data-dropdown-target="menu"
            class="hidden absolute bottom-full mb-2 left-0 w-48 bg-popover border border-border rounded-md shadow-md p-1 bg-background">
            <button data-action="click->theme#toggle"
              class="w-full flex items-center gap-2 px-2 py-1.5 text-sm rounded-sm hover:bg-accent text-left">
              <%= lucide_icon "sun-moon", class: "w-4 h-4" %>
              Switch theme
            </button>
            <%= render_separator class: "mt-1 mb-1" %>
            <%= button_to destroy_user_session_path, method: :delete, class: "w-full text-destructive hover:bg-destructive/10 hover:text-destructive-foreground flex items-center gap-2 px-2 py-1.5 text-sm rounded-sm text-left" do %>
              <%= lucide_icon "log-out", class: "w-4 h-4" %>
              Logout
            <% end %>
          </div>
        </div>
      </div>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden">
      <%= render "shared/breadcrumbs" , breadcrumbs: auto_breadcrumbs %>

      <main class="flex-1 overflow-y-auto p-8">
        <%= render "shared/toasts" %>
        <%= yield %>
      </main>
    </div>
  </div>
</body>

</html>
