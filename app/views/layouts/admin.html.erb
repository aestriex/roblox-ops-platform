<!DOCTYPE html>
<html>

<head>
  <title>
    <%= content_for(:title) || "Hiring Portal" %>
  </title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <script>
    if (localStorage.theme === "dark" || (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
      document.documentElement.classList.add("dark");
    }
  </script>
</head>

<body class="bg-background text-foreground transition-all duration-300 antialiased" data-controller="theme">
  <div class="flex h-screen">
      <aside class="w-64 border-r border-border bg-muted/40 flex flex-col">
        <div class="h-header border-b border-border relative flex items-center gap-1 px-1">
          <div class="flex-1 min-w-0">
            <%= render_popover do %>
              <% popover_trigger do %>
                <button class="w-full flex items-center gap-2 p-2 rounded-md cursor-pointer hover:bg-accent">
                  <%= image_tag current_user.display_avatar_url, class: "w-8 h-8 rounded-sm" %>
                  <div class="flex-1 text-left min-w-0">
                    <p class="text-sm font-medium text-foreground truncate"><%= current_user.display_name %></p>
                    <p class="text-xs text-muted-foreground truncate"><%= current_user.highest_role&.name || "No Role" %></p>
                  </div>
                </button>
              <% end %>

              <% popover_content class: "w-56 p-1", side: "bottom-start" do %>
                <button data-action="click->theme#toggle" class="w-full flex items-center gap-2 px-2 py-1.5 text-sm rounded-sm hover:bg-accent text-left cursor-pointer">
                  <%= lucide_icon "sun-moon", class: "w-4 h-4" %> Switch theme
                </button>

                <% if current_user.can?("admin.configurations.edit") %>
                  <%= link_to edit_admin_configurations_path, class: "w-full flex items-center gap-2 px-2 py-1.5 text-sm rounded-sm text-left hover:bg-accent" do %>
                    <%= lucide_icon "settings", class: "w-4 h-4" %> Configuration
                  <% end %>
                <% end %>

                <%= render_separator class: "my-1" %>

                <%= button_to destroy_user_session_path, method: :delete, class: "w-full text-destructive hover:bg-destructive/10 hover:text-destructive-foreground flex items-center gap-2 px-2 py-1.5 text-sm rounded-sm text-left" do %>
                  <%= lucide_icon "log-out", class: "w-4 h-4" %> Logout
                <% end %>
              <% end %>
            <% end %>
          </div>

          <div class="shrink-0">
            <%= render_popover do %>
              <% popover_trigger do %>
                <button class="relative p-2 rounded-md hover:bg-accent cursor-pointer">
                  <%= lucide_icon "bell", class: "w-4 h-4 text-muted-foreground" %>
                  <% if current_user.notifications.unread.exists? %>
                    <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-destructive"></span>
                  <% end %>
                </button>
              <% end %>

              <% popover_content class: "w-80 p-1", side: "bottom-end" do %>
                <%= render "notifications/list" %>
              <% end %>
            <% end %>
          </div>
        </div>

        <nav class="flex-1 py-4 px-1 space-y-4 overflow-y-auto">
          <% visible_nav_sections.each do |group| %>
            <%= tag.div class: "group", data: (group[:section] ? { controller: "ui--collapsible", "ui--collapsible-key-value": group[:section] } : {}) do %>
              <% if group[:section] %>
                <button type="button" data-action="click->ui--collapsible#toggle" class="w-full flex items-center gap-1 px-3 mb-1 cursor-pointer">
                  <%= lucide_icon "chevron-down", class: "w-3.5 h-3.5 text-muted-foreground transition-transform duration-200 group-has-[[data-ui--collapsible-target].hidden]:-rotate-90" %>
                  <p class="text-sm text-muted-foreground">
                    <%= group[:section] %>
                  </p>
                </button>
              <% end %>

              <div data-ui--collapsible-target="item" class="space-y-1">
                <% group[:items].each do |item| %>
                  <% active = current_page?(send(item[:path])) %>
                  <%= link_to send(item[:path]), class: tw("flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium tracking-tight transition-all duration-300", active ? "bg-accent text-accent-foreground" : "hover:bg-accent hover:text-accent-foreground") do %>
                    <%= lucide_icon item[:icon], class: "w-4 h-4" %>
                    <span class="flex-1 truncate"><%= item[:label] %></span>
                    <% if item[:managerial] %>
                      <%= lucide_icon "circuit-board", class: "w-4 h-4 text-muted-foreground shrink-0" %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </nav>

        <script>
          document.querySelectorAll("[data-ui--collapsible-key-value]").forEach(function (group) {
            var key = group.getAttribute("data-ui--collapsible-key-value");
            if (localStorage.getItem("sidebar-collapsed:" + key) === "collapsed") {
              group.querySelectorAll('[data-ui--collapsible-target="item"]').forEach(function (item) {
                item.classList.add("hidden");
              });
            }
          });
        </script>

        <div class="p-3 border-t border-border space-y-1">
          <% Configuration.instance.external_links.each do |link| %>
            <%= link_to link[:url], target: "_blank", rel: "noopener", class: "flex items-center gap-2 px-2 py-1.5 text-sm rounded-md hover:bg-accent text-muted-foreground" do %>
              <%= safe_lucide_icon link[:icon].presence || "link", class: "w-4 h-4 shrink-0" %>
              <span class="flex-1 text-left truncate"><%= link[:label] %></span>
              <%= lucide_icon "external-link", class: "w-4 h-4 shrink-0" %>
            <% end %>
          <% end %>

          <div class="px-3 text-xs text-muted-foreground flex gap-2 items-center justify-center">
            <span>v<%= RobloxOpsPlatform::VERSION %></span>
            <span>·</span>
            <%= link_to "Report a bug", "https://github.com/aestriex/roblox-ops-platform/issues/new", target: "_blank", rel: "noopener", class: "hover:text-foreground underline" %>
          </div>
        </div>
      </aside>

    <div class="flex-1 flex flex-col overflow-hidden">
      <%= render "shared/breadcrumbs" , breadcrumbs: auto_breadcrumbs %>

      <main class="flex-1 overflow-y-auto p-8">
        <%= render "shared/toasts" %>
        <%= yield %>
      </main>
    </div>
  </div>
</body>

</html>
