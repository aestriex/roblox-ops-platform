<h1 class="text-2xl font-semibold mb-2">Edit <%= @role.name %></h1>
<p class="text-muted-foreground mb-8"><%= @role.description %></p>

<%= form_with model: @role, url: admin_role_path(@role), method: :patch, class: "space-y-3" do |form| %>
  <% @all_permissions.each do |permission| %>
  <%= render_checkbox(
    label: permission.description,
    name: "permission_ids[]",
    value: permission.id,
    checked: @role.permissions.include?(permission)
  ) %>
<% end %>

  <%= render_button "Save Permissions", type: :submit %>
<% end %>