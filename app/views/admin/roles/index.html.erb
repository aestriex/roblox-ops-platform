<h1 class="text-2xl font-semibold mb-6">Roles</h1>

<div class="space-y-2">
  <% @roles.each do |role| %>
    <%= link_to admin_role_path(role), class: "flex items-center justify-between p-4 border border-border rounded-md hover:bg-accent transition-all duration-300" do %>
      <div>
        <p class="font-medium"><%= role.name %></p>
        <p class="text-sm text-muted-foreground"><%= role.description %></p>
      </div>
      <%= lucide_icon "chevron-right", class: "w-4 h-4 text-muted-foreground" %>
    <% end %>
  <% end %>
</div>