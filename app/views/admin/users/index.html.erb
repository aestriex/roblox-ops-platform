<h1 class="text-2xl font-semibold mb-6">Users</h1>

<div class="space-y-2">
  <% @users.each do |user| %>
    <%= link_to edit_admin_user_path(user), class: "flex items-center justify-between p-4 border border-border rounded-md hover:bg-accent" do %>
      <div class="flex items-center gap-3">
        <%= image_tag user.display_avatar_url, class: "w-8 h-8 rounded-full" %>
        <div>
          <p class="font-medium"><%= user.display_name %></p>
          <p class="text-sm text-muted-foreground"><%= user.roles.map(&:name).join(", ").presence || "No roles assigned" %></p>
        </div>
      </div>
      <%= lucide_icon "chevron-right", class: "w-4 h-4 text-muted-foreground" %>
    <% end %>
  <% end %>
</div>