<h1 class="text-2xl font-semibold mb-2">Edit Roles</h1>
<p class="text-muted-foreground mb-8"><%= @user.display_name %></p>

<%= form_with model: @user, url: admin_user_path(@user), method: :patch, class: "space-y-3" do |form| %>
  <% @all_roles.each do |role| %>
    <%= render_checkbox(
      label: "#{role.name} — #{role.description}",
      name: "role_ids[]",
      value: role.id,
      checked: @user.roles.include?(role)
    ) %>
  <% end %>

  <%= render_button "Save Roles", type: :submit %>
<% end %>