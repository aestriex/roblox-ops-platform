<div class="space-y-4" data-controller="ui--search" data-ui--search-pattern-value="{input}">
  <div class="flex items-center justify-between gap-2 flex-wrap">
    <div class="flex items-center gap-2 flex-wrap">
      <%= render_filter_bar(Workspace::Milestone, context: project, current_params: params.permit(:locked).to_h) %>

      <div class="relative">
        <%= lucide_icon "search", class: "w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none" %>
        <%= render_input name: "search", placeholder: "Search milestones...", class: "max-w-xs pl-9", data: { "ui--search-target": "source", action: "input->ui--search#search" } %>
      </div>
    </div>

    <%= render_dialog do %>
      <% dialog_trigger do %>
        <%= render_button variant: :outline do %>
          <%= lucide_icon "plus", class: "w-4 h-4 mr-2" %> Add Milestone
        <% end %>
      <% end %>

      <% dialog_content do %>
        <% new_milestone = Workspace::Milestone.new(project: project) %>
        <h2 class="text-lg font-semibold text-foreground mb-6">New Milestone</h2>
        <%= turbo_frame_tag new_milestone.dialog_form_id do %>
          <%= render "workspace/milestones/form", project: project, milestone: new_milestone %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= render_table do %>
    <%= table_head do %>
      <%= table_header "Name" %>
      <%= table_header "Target Date" %>
      <%= table_header "Locked" %>
      <%= table_header "" %>
    <% end %>

    <%= table_body do %>
      <% milestones.each do |milestone| %>
        <%= table_row data: { "ui--search-target": "item" } do %>
          <%= table_column milestone.name %>
          <%= table_column milestone.target_date&.strftime("%b %-d, %Y") || "—" %>
          <%= table_column do %>
            <% if milestone.locked? %>
              <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-muted text-muted-foreground">Locked</span>
            <% end %>
          <% end %>
          <%= table_column class: "text-right" do %>
            <%= render_dialog do %>
              <% dialog_trigger do %>
                <%= render_button variant: :ghost, class: "h-5 w-5 p-0" do %>
                  <%= lucide_icon "pencil", class: "w-4 h-4" %>
                <% end %>
              <% end %>
              <% dialog_content do %>
                <h2 class="text-lg font-semibold text-foreground mb-6">Edit <%= milestone.name %></h2>
                <%= turbo_frame_tag milestone.dialog_form_id do %>
                  <%= render "workspace/milestones/form", project: project, milestone: milestone %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
