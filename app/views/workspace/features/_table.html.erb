<div class="space-y-4" data-controller="ui--search" data-ui--search-pattern-value="{input}">
  <div class="flex items-center justify-between gap-2 flex-wrap">
    <div class="flex items-center gap-2 flex-wrap">
      <%= render_filter_bar(Workspace::Feature, context: project, current_params: params.permit(:milestone_id).to_h) %>

      <div class="relative">
        <%= lucide_icon "search", class: "w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none" %>
        <%= render_input name: "search", placeholder: "Search features...", class: "max-w-xs pl-9", data: { "ui--search-target": "source", action: "input->ui--search#search" } %>
      </div>
    </div>

    <%= render_dialog do %>
      <% dialog_trigger do %>
        <%= render_button variant: :outline do %>
          <%= lucide_icon "plus", class: "w-4 h-4 mr-2" %> Add Feature
        <% end %>
      <% end %>

      <% dialog_content do %>
        <% new_feature = Workspace::Feature.new(project: project) %>
        <h2 class="text-lg font-semibold text-foreground mb-6">New Feature</h2>
        <%= turbo_frame_tag new_feature.dialog_form_id do %>
          <%= render "workspace/features/form", project: project, feature: new_feature %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= render_table do %>
    <%= table_head do %>
      <%= table_header "Name" %>
      <%= table_header "Deliverables" %>
      <%= table_header "" %>
    <% end %>

    <%= table_body do %>
      <% features.each do |feature| %>
        <%= table_row data: { "ui--search-target": "item" } do %>
          <%= table_column feature.name %>
          <%= table_column feature.deliverables.count %>
          <%= table_column class: "text-right" do %>
            <%= render_dialog do %>
              <% dialog_trigger do %>
                <%= render_button variant: :ghost, class: "h-5 w-5 p-0" do %>
                  <%= lucide_icon "pencil", class: "w-4 h-4" %>
                <% end %>
              <% end %>
              <% dialog_content do %>
                <h2 class="text-lg font-semibold text-foreground mb-6">Edit <%= feature.name %></h2>
                <%= turbo_frame_tag feature.dialog_form_id do %>
                  <%= render "workspace/features/form", project: project, feature: feature %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
