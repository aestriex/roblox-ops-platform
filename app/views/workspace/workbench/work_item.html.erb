<%= turbo_frame_tag "sheet_content_frame" do %>
  <div class="flex flex-col mt-4 px-4 space-y-4">
    <% if @work_item.blocked? %>
      <div class="flex items-center p-4 rounded-md bg-muted/40 border border-border">
        <div class="flex gap-4 items-center grow">
          <%= lucide_icon "clock-alert", class: "w-6 h-6" %>
          <div class="flex flex-col">
            <p class="text-sm font-semibold">This work item has been marked as blocked</p>
            <p class="text-sm text-muted-foreground"><%= @work_item.blocked_reason.presence || "(No reason provided)" %></p>
          </div>
        </div>
      </div>
    <% end %>

    <div class="space-y-3">
      <div class="grid grid-cols-[140px_1fr] gap-4">
        <p class="text-sm text-muted-foreground">Deliverable</p>
        <p class="text-sm text-foreground"><%= @work_item.deliverable.name %></p>
      </div>

      <div class="grid grid-cols-[140px_1fr] gap-4">
        <p class="text-sm text-muted-foreground">Feature</p>
        <p class="text-sm text-foreground"><%= @work_item.deliverable.feature.name %></p>
      </div>

      <div class="grid grid-cols-[140px_1fr] gap-4">
        <p class="text-sm text-muted-foreground">Status</p>
        <span class="w-fit px-2 py-1 rounded-full text-xs font-medium bg-muted text-muted-foreground"><%= @work_item.status.titleize %></span>
      </div>

      <div class="grid grid-cols-[140px_1fr] gap-4">
        <p class="text-sm text-muted-foreground">Assignee</p>
        <p class="text-sm text-foreground"><%= @work_item.assignee&.full_name || "Unassigned" %></p>
      </div>

      <div class="grid grid-cols-[140px_1fr] gap-4">
        <p class="text-sm text-muted-foreground">Due Date</p>
        <p class="text-sm text-foreground"><%= @work_item.due_date&.strftime("%b %-d, %Y") || "—" %></p>
      </div>

      <div class="grid grid-cols-[140px_1fr] gap-4">
        <p class="text-sm text-muted-foreground">Description</p>
        <p class="text-sm text-foreground"><%= @work_item.description.presence || "No description" %></p>
      </div>
    </div>

    <div class="pt-4 border-t border-border">
      <div class="flex items-center justify-between mb-3">
        <p class="text-sm font-medium text-foreground">Submissions</p>

        <%= render_dialog do %>
          <%= dialog_trigger do %>
            <%= render_button variant: :ghost, class: "h-8 w-8 p-0" do %>
              <%= lucide_icon "plus", class: "w-4 h-4" %>
            <% end %>
          <% end %>

          <%= dialog_content do %>
            <h2 class="text-lg font-semibold text-foreground mb-6">Add Submission</h2>

            <%= turbo_frame_tag Workspace::Submission.new.dialog_form_id do %>
              <%= render "workspace/submissions/form",
                    project: @work_item.deliverable.feature.project,
                    feature: @work_item.deliverable.feature,
                    deliverable: @work_item.deliverable,
                    work_item: @work_item,
                    submission: Workspace::Submission.new %>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <% if @work_item.submissions.any? %>
        <div class="space-y-2">
          <% @work_item.submissions.includes(:submitted_by).order(created_at: :desc).each do |submission| %>
            <div class="p-3 border border-border rounded-lg space-y-1">
              <p class="text-sm text-foreground"><%= submission.notes %></p>
              <p class="text-xs text-muted-foreground">
                Submitted by <%= submission.submitted_by.full_name %> on <%= submission.created_at.strftime("%b %-d, %Y") %>
              </p>
              <% if submission.package.attached? %>
                <%= link_to submission.package.filename, rails_blob_path(submission.package, disposition: "attachment"), class: "text-sm text-primary underline" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-muted-foreground">No submissions yet.</p>
      <% end %>
    </div>
  </div>
<% end %>
