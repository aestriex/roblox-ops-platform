<%= form_with model: project, url: project.persisted? ? workspace_project_path(project) : workspace_projects_path, scope: :project, class: "space-y-4", data: { turbo_frame: "_top" } do |form| %>
  <% if project.errors.any? %>
    <div class="text-sm text-destructive space-y-1">
      <% project.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

    <div>
      <%= form.label :name, class: "block font-medium text-foreground mb-1" %>
      <%= form.text_field :name, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
    </div>
    <div>
      <%= form.label :description, class: "block font-medium text-foreground mb-1" %>
      <%= form.text_field :description, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
    </div>

  <%= render_button project.persisted? ? "Save changes" : "Create project", type: :submit %>
<% end %>
