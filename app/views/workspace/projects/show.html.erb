<div class="mx-auto space-y-8">
  <div>
    <h1 class="text-2xl font-bold text-foreground"><%= @project.name %></h1>
    <p class="text-sm text-muted-foreground"><%= @project.description %></p>
  </div>

  <%= render_tabs do %>
    <% tab_list do %>
      <%= tab "Milestones", active: true, icon: "flag" %>
      <%= tab "Features", icon: "layers" %>
      <%= tab "Deliverables", icon: "package" %>
    <% end %>

    <% tab_panels do %>
      <%= tab_panel active: true do %>
        <%= render "workspace/milestones/table", project: @project %>
      <% end %>

      <%= tab_panel do %>
        <%= render "workspace/features/table", project: @project %>
      <% end %>

      <%= tab_panel do %>
        <%= turbo_frame_tag "deliverables_table", src: workspace_project_deliverables_path(@project) %>
      <% end %>
    <% end %>
  <% end %>
</div>
