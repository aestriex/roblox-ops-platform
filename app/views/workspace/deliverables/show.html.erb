<%= turbo_frame_tag "sheet_content_frame" do %>
  <div class="p-4 space-y-4">
    <h2 class="text-lg font-semibold text-foreground"><%= @deliverable.name %></h2>
    <p class="text-sm text-muted-foreground"><%= @deliverable.description %></p>

    <div>
      <div class="flex items-center justify-between mb-2">
        <p class="text-xs font-medium text-muted-foreground uppercase">Work Items</p>

        <%= render_dialog do %>
          <% dialog_trigger do %>
            <%= render_button variant: :outline do %>
              <%= lucide_icon "plus", class: "w-4 h-4 mr-2" %> Add Work Item
            <% end %>
          <% end %>

          <% dialog_content do %>
            <% new_work_item = Workspace::WorkItem.new(deliverable: @deliverable) %>
            <h2 class="text-lg font-semibold text-foreground mb-6">New Work Item</h2>

            <%= turbo_frame_tag new_work_item.dialog_form_id do %>
              <%= render "workspace/work_items/form", project: @project, feature: @deliverable.feature, deliverable: @deliverable, work_item: new_work_item, assignees: Personnel::Person.all %>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <% @deliverable.work_items.each do |work_item| %>
        <div
          data-controller="ui--sheet-trigger"
          data-ui--sheet-trigger-outlet-value="#deliverable_sheet"
          data-ui--sheet-trigger-url-value="<%= workspace_project_work_item_path(@project, work_item) %>"
          data-ui--sheet-trigger-title-value="<%= work_item.title %>"
          data-action="click->ui--sheet-trigger#open"
          class="p-2 border border-border rounded-md mb-2 text-sm cursor-pointer hover:bg-accent transition-colors duration-100 flex items-center justify-between">
          <span><%= work_item.title %></span>
          <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-muted text-muted-foreground"><%= work_item.status.titleize %></span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
