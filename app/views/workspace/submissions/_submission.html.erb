<div id="<%= dom_id(submission) %>" class="p-4 border border-border rounded-lg mb-3 flex items-start justify-between">
  <div class="space-y-1">
    <p class="text-sm text-foreground"><%= submission.notes %></p>
    <p class="text-xs text-muted-foreground">
      Submitted by <%= submission.submitted_by.full_name %> on <%= submission.created_at.strftime("%b %-d, %Y") %>
    </p>
    <% if submission.package.attached? %>
      <%= link_to submission.package.filename, rails_blob_path(submission.package, disposition: "attachment"), class: "text-sm text-primary underline" %>
    <% end %>
  </div>

  <%= render_alert_dialog do %>
    <% alert_dialog_trigger do %>
      <%= render_button variant: :ghost do %>
        <%= lucide_icon "trash", class: "w-4 h-4 text-destructive" %>
      <% end %>
    <% end %>

    <% alert_dialog_content do %>
      <h2 class="text-lg font-semibold text-foreground mb-2">Delete this submission?</h2>
      <p class="text-sm text-muted-foreground">This action cannot be undone.</p>
    <% end %>

    <% alert_dialog_cancel do %>
      <%= render_button "Cancel", variant: :outline %>
    <% end %>

    <% alert_dialog_continue do %>
      <%= button_to "Delete", workspace_project_feature_deliverable_work_item_submission_path(project, feature, deliverable, work_item, submission), method: :delete, form: { data: { turbo_frame: "_top" } }, class: "px-4 py-2 rounded-md bg-destructive text-destructive-foreground hover:opacity-90 text-sm font-medium" %>
    <% end %>
  <% end %>
</div>
