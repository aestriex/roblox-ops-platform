<%= form_with model: submission, url: workspace_project_feature_deliverable_work_item_submissions_path(project, feature, deliverable, work_item), scope: :submission, multipart: true, class: "space-y-4", data: { turbo_frame: "sheet_content_frame" } do |form| %>
  <% if submission.errors.any? %>
    <div class="text-sm text-destructive space-y-1">
      <% submission.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :notes, class: "block font-medium text-foreground mb-1" %>
    <%= form.text_area :notes, rows: 3, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
  </div>

  <div>
    <%= form.label :package, "Attachment", class: "block font-md text-foreground mb-1" %>

    <div data-controller="file-upload">
      <div
        data-file-upload-target="dropzone"
        data-action="click->file-upload#open"
        class="flex items-center justify-center gap-2 px-6 py-8 border border-dashed border-input rounded-md text-sm text-muted-foreground w-full cursor-pointer transition-colors duration-150 hover:border-primary/50"
      >
        <%= lucide_icon "paperclip", class: "w-4 h-4" %>
        <span data-file-upload-target="label">
          Click to upload or drag and drop
        </span>
      </div>

      <%= form.file_field :package, class: "hidden", data: { file_upload_target: "input", action: "file-upload#change" } %>
    </div>
  </div>

  <%= render_button "Submit", type: :submit %>
<% end %>
