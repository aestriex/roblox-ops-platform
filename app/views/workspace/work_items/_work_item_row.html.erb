<%= table_row class: "relative" do %>
  <%= table_column do %>
    <%= link_to work_item.title, workspace_project_feature_deliverable_work_item_path(project, feature, deliverable, work_item), class: "after:absolute after:inset-0" %>
  <% end %>
  <%= table_column do %>
    <span class="px-2 py-1 rounded-full text-xs font-medium bg-muted text-muted-foreground"><%= work_item.status.titleize %></span>
    <% if work_item.blocked? %>
      <span class="px-2 py-1 rounded-full text-xs font-medium bg-destructive/10 text-destructive">Blocked</span>
    <% end %>
  <% end %>
  <%= table_column work_item.assignee&.full_name || "Unassigned" %>
  <%= table_column work_item.due_date&.strftime("%b %-d, %Y") %>
  <%= table_column class: "relative z-10" do %>
    <div class="flex justify-end gap-1">
      <%= render_dialog do %>
        <% dialog_trigger do %>
          <%= render_button variant: :ghost do %>
            <%= lucide_icon "pencil", class: "w-4 h-4" %>
          <% end %>
        <% end %>

        <% dialog_content do %>
          <h2 class="text-lg font-semibold text-foreground mb-6">Edit <%= work_item.title %></h2>

          <%= turbo_frame_tag work_item.dialog_form_id do %>
            <%= render "workspace/work_items/form", project: project, feature: feature, deliverable: deliverable, work_item: work_item, assignees: Personnel::Person.all %>
          <% end %>
        <% end %>
      <% end %>

      <%= render_alert_dialog do %>
        <% alert_dialog_trigger do %>
          <%= render_button variant: :ghost do %>
            <%= lucide_icon "trash", class: "w-4 h-4 text-destructive" %>
          <% end %>
        <% end %>

        <% alert_dialog_content do %>
          <h2 class="text-lg font-semibold text-foreground mb-2">Delete this work item?</h2>
          <p class="text-sm text-muted-foreground">This will remove all of its submissions. This action cannot be undone.</p>
        <% end %>

        <% alert_dialog_cancel do %>
          <%= render_button "Cancel", variant: :outline %>
        <% end %>

        <% alert_dialog_continue do %>
          <%= button_to "Delete", workspace_project_feature_deliverable_work_item_path(project, feature, deliverable, work_item), method: :delete, form: { data: { turbo_frame: "_top" } }, class: "px-4 py-2 rounded-md bg-destructive text-destructive-foreground hover:opacity-90 text-sm font-medium" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
