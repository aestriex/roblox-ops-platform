<%= turbo_frame_tag "sheet_content_frame" do %>
  <div class="flex flex-col mt-4">
    <div>
      <div class="grid grid-cols-[140px_1fr] gap-4 px-4 py-2.5">
        <p class="text-sm text-muted-foreground">Status</p>
        <%= render "workspace/work_items/status_field", work_item: @work_item %>
      </div>

      <div class="grid grid-cols-[140px_1fr] gap-4 px-4 py-2.5">
        <p class="text-sm text-muted-foreground">Assignee</p>

        <div data-controller="ui--click-parse ui--dialog">
          <span data-ui--click-parse-target="display" data-action="click->ui--click-parse#handleClick dblclick->ui--click-parse#handleDblClick ui--click-parse:singleClick->ui--dialog#open" class="underline decoration-dotted decoration-muted-foreground text-sm text-foreground cursor-pointer select-none">
            <%= @work_item.assignee&.full_name || "Unassigned" %>
          </span>

          <%= render_dialog do %>
            <% dialog_content do %>
              <% if @work_item.assignee %>
                <h2 class="text-lg font-semibold text-foreground mb-2"><%= @work_item.assignee.full_name %></h2>
                <p class="text-sm text-muted-foreground"><%= @work_item.assignee.position %> — <%= @work_item.assignee.department %></p>
              <% else %>
                <p class="text-sm text-muted-foreground">No one is currently assigned.</p>
              <% end %>
            <% end %>
          <% end %>

          <div data-ui--click-parse-target="editForm" class="hidden">
            <%= form_with url: update_assignee_workspace_project_feature_deliverable_work_item_path(@work_item.deliverable.feature.project, @work_item.deliverable.feature, @work_item.deliverable, @work_item), method: :patch, data: { turbo_frame: "sheet_content_frame" } do %>
              <%= render_combobox(
                Personnel::Person.all.map { |p| { value: p.id, name: p.full_name, avatar: p.user&.display_avatar_url } },
                name: "assignee_id",
                selected_value: @work_item.assignee_id,
                selected_label: @work_item.assignee&.full_name
              ) %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-[140px_1fr] gap-4 px-4 py-2.5">
        <p class="text-sm text-muted-foreground">Due Date</p>

        <div data-controller="ui--click-parse">
          <p data-ui--click-parse-target="display" data-action="dblclick->ui--click-parse#handleDblClick" class="group inline-flex items-center gap-1 px-2 py-1 -ml-2 rounded-md border border-transparent hover:border-input cursor-pointer select-none w-fit text-sm text-foreground">
            <%= @work_item.due_date&.strftime("%b %-d, %Y") || "—" %>
            <%= lucide_icon "pencil", class: "w-3 h-3 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity" %>
          </p>

          <div data-ui--click-parse-target="editForm" class="hidden">
            <%= form_with url: update_due_date_workspace_project_feature_deliverable_work_item_path(@work_item.deliverable.feature.project, @work_item.deliverable.feature, @work_item.deliverable, @work_item), method: :patch, data: { turbo_frame: "sheet_content_frame" } do |form| %>
              <%= render_date_picker(name: "due_date", value: @work_item.due_date) %>
              <%= render_button "Save", type: :submit, class: "mt-2" %>
            <% end %>
          </div>
        </div>
      </div>

      <% if @work_item.blocked? %>
        <div class="grid grid-cols-[140px_1fr] gap-4 px-4 py-2.5">
          <p class="text-sm text-muted-foreground">Blocked</p>
          <p class="text-sm text-destructive"><%= @work_item.blocked_reason %></p>
        </div>
      <% end %>

      <div class="grid grid-cols-[140px_1fr] gap-4 px-4 py-2.5">
        <p class="text-sm text-muted-foreground">Description</p>

        <div data-controller="ui--click-parse">
          <p data-ui--click-parse-target="display" data-action="dblclick->ui--click-parse#handleDblClick" class="group flex items-start justify-between gap-2 px-2 py-1 -ml-2 rounded-md border border-transparent hover:border-input cursor-pointer select-none text-sm text-foreground">
            <span><%= @work_item.description.presence || "No description" %></span>
            <%= lucide_icon "pencil", class: "w-3 h-3 shrink-0 mt-0.5 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity" %>
          </p>

          <div data-ui--click-parse-target="editForm" class="hidden">
            <%= form_with url: update_description_workspace_project_feature_deliverable_work_item_path(@work_item.deliverable.feature.project, @work_item.deliverable.feature, @work_item.deliverable, @work_item), method: :patch, data: { turbo_frame: "sheet_content_frame" } do |form| %>
              <%= form.text_area :description, value: @work_item.description, rows: 3, class: "w-full border border-input rounded-md px-2 py-1.5 text-sm bg-background" %>
              <%= render_button "Save", type: :submit, class: "mt-2" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="px-4 pt-4">
      <%= render_tabs do %>
        <% tab_list do %>
          <%= tab "Submissions", active: true, icon: "upload" %>
          <%= tab "Activity", icon: "history" %>
        <% end %>

        <% tab_panels do %>
          <%= tab_panel active: true do %>
            <div class="space-y-2">
              <% @work_item.submissions.each do |submission| %>
                <div class="p-2 border border-border rounded-md text-sm">
                  <p class="text-foreground"><%= submission.notes %></p>
                  <p class="text-xs text-muted-foreground">by <%= submission.submitted_by.full_name %> on <%= submission.created_at.strftime("%b %-d, %Y") %></p>
                </div>
              <% end %>
            </div>
          <% end %>

          <%= tab_panel do %>
            <p class="text-sm text-muted-foreground italic">Activity log coming soon.</p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
