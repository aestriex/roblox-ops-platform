<%= turbo_frame_tag "sheet_content_frame" do %>
  <div class="flex flex-col mt-4">
    <% if @work_item.blocked? %>
        <div class="flex items-center p-4 m-4 rounded-md bg-muted/40 border border-border">
            <div class="flex gap-4 items-center grow">
                <%= lucide_icon "clock-alert", class: "w-6 h-6" %>
                <div class="flex flex-col">
                    <p class="text-sm font-semibold ">This work item has been marked as blocked</p>
                    <p class="text-sm text-muted-foreground"><%= @work_item.blocked_reason.presence || "(No reason provided)" %></p>
                </div>
            </div>
            <%= button_to "Unblock", update_flag_workspace_project_feature_deliverable_work_item_path(@project, @work_item.deliverable.feature, @work_item.deliverable, @work_item), method: :patch, params: { blocked: "false" }, form: { data: { turbo_frame: "sheet_content_frame" } }, class: "px-3 py-1.5 rounded-md border border-input text-sm font-medium hover:bg-accent" %>        </div>
    <% end %>

    <div>
      <div class="grid grid-cols-[140px_1fr] gap-4 px-4 py-2.5">
        <p class="text-sm text-muted-foreground">Status</p>
        <%= render "workspace/work_items/status_field", work_item: @work_item %>
      </div>

      <div class="grid grid-cols-[140px_1fr] gap-4 px-4 py-2.5">
        <p class="text-sm text-muted-foreground">Assignee</p>

        <div data-controller="inline-edit" data-inline-edit-clear-on-edit-value="true">
          <span data-inline-edit-target="display" data-action="click->inline-edit#edit" class="group inline-flex items-center gap-1 px-2 py-1 -ml-2 rounded-md border border-transparent hover:border-input cursor-pointer select-none text-sm text-foreground">
            <%= @work_item.assignee&.full_name || "Unassigned" %>
            <%= lucide_icon "pencil", class: "w-3 h-3 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity" %>
          </span>

          <%= form_with url: update_assignee_workspace_project_feature_deliverable_work_item_path(@work_item.deliverable.feature.project, @work_item.deliverable.feature, @work_item.deliverable, @work_item), method: :patch, class: "!hidden", data: { inline_edit_target: "form", turbo_frame: "sheet_content_frame", action: "ui--combobox:select->inline-edit#save" } do %>
            <div class="relative" data-controller="ui--search ui--combobox" data-ui--search-pattern-value="^{input}">
              <%= hidden_field_tag "assignee_id", @work_item.assignee_id, data: { "ui--combobox-target": "input" } %>

              <%= text_field_tag :assignee_search, @work_item.assignee&.full_name, autocomplete: "off", placeholder: "Search people...",
                    class: "w-full border border-input rounded-md px-2 py-1 text-sm bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
                    data: {
                      "ui--search-target": "source",
                      "ui--combobox-target": "label",
                      "inline-edit-target": "input",
                      action: "input->ui--search#search keydown->inline-edit#submitOnEnter"
                    } %>

              <div class="absolute z-10 mt-1 w-56 rounded-md border border-border bg-background text-foreground shadow-md max-h-48 overflow-auto p-1">
                <% Personnel::Person.all.each do |person| %>
                  <div data-ui--search-target="item">
                    <%= search_list_item(value: person.id, name: person.full_name, selected: person.id == @work_item.assignee_id, avatar: person.user&.display_avatar_url) %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-[140px_1fr] gap-4 px-4 py-2.5">
        <p class="text-sm text-muted-foreground">Due Date</p>

        <div class="relative" data-controller="inline-edit" data-inline-edit-clear-on-edit-value="true">
          <p data-inline-edit-target="display" data-action="click->inline-edit#edit" class="group inline-flex items-center gap-1 px-2 py-1 -ml-2 rounded-md border border-transparent hover:border-input cursor-pointer select-none w-fit text-sm text-foreground">
            <%= @work_item.due_date&.strftime("%b %-d, %Y") || "—" %>
            <%= lucide_icon "pencil", class: "w-3 h-3 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity" %>
          </p>

          <%= form_with url: update_due_date_workspace_project_feature_deliverable_work_item_path(@work_item.deliverable.feature.project, @work_item.deliverable.feature, @work_item.deliverable, @work_item), method: :patch, class: "!hidden absolute top-0 left-0 z-10", data: { inline_edit_target: "form", turbo_frame: "sheet_content_frame" } do %>
            <%= render_date_picker(
              name: "due_date",
              value: @work_item.due_date,
              input_html: { data: { "inline-edit-target": "input", action: "keydown->inline-edit#submitOnEnter" } }
            ) %>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-[140px_1fr] gap-4 px-4 py-2.5">
        <p class="text-sm text-muted-foreground">Description</p>

        <div data-controller="inline-edit" data-inline-edit-blur-action-value="save">
          <p data-inline-edit-target="display" data-action="click->inline-edit#edit" class="group flex items-start justify-between gap-2 px-2 py-1 -ml-2 rounded-md border border-transparent hover:border-input cursor-pointer select-none text-sm text-foreground">
            <span><%= @work_item.description.presence || "No description" %></span>
            <%= lucide_icon "pencil", class: "w-3 h-3 shrink-0 mt-0.5 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity" %>
          </p>

          <%= form_with url: update_description_workspace_project_feature_deliverable_work_item_path(@work_item.deliverable.feature.project, @work_item.deliverable.feature, @work_item.deliverable, @work_item), method: :patch, class: "!hidden", data: { inline_edit_target: "form", turbo_frame: "sheet_content_frame" } do |form| %>
            <%= form.text_area :description, value: @work_item.description, rows: 3, class: "w-full border border-input rounded-md px-2 py-1.5 text-sm bg-background", data: { inline_edit_target: "input", action: "keydown->inline-edit#submitOnEnter" } %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="px-4 pt-4">
      <%= render_tabs do %>
        <% tab_list do %>
          <%= tab "Submissions", active: true, icon: "upload" %>
          <%= tab "Activity", icon: "history" %>
        <% end %>

        <% tab_panels do %>
          <%= tab_panel active: true do %>
            <div class="space-y-2">
              <% @work_item.submissions.each do |submission| %>
                <div class="p-2 border border-border rounded-md text-sm">
                  <p class="text-foreground"><%= submission.notes %></p>
                  <p class="text-xs text-muted-foreground">by <%= submission.submitted_by.full_name %> on <%= submission.created_at.strftime("%b %-d, %Y") %></p>
                </div>
              <% end %>
            </div>
          <% end %>

          <%= tab_panel do %>
            <div class="space-y-2">
              <% if @activity_logs.present? %>
                <% @activity_logs.each do |log| %>
                  <%= render "workspace/work_items/activity_log_entry", log: log %>
                <% end %>
              <% else %>
                <p class="text-sm text-muted-foreground italic">No activity yet.</p>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
