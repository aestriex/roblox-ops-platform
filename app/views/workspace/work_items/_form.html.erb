<% form_url = if work_item.persisted?
  workspace_project_feature_deliverable_work_item_path(project, feature, deliverable, work_item)
elsif deliverable
  workspace_project_feature_deliverable_work_items_path(project, feature, deliverable)
else
  workspace_project_work_items_path(project)
end %>
<%= form_with model: work_item, url: form_url, scope: :work_item, class: "space-y-4", data: { turbo_frame: "_top" } do |form| %>
  <% if work_item.errors.any? %>
    <div class="text-sm text-destructive space-y-1">
      <% work_item.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <% if local_assigns[:deliverables].present? %>
    <div>
      <p class="block font-medium text-foreground mb-1">Deliverable</p>
      <%= render_combobox(
        deliverables.map { |d| { value: d.id, name: "#{d.feature.name} / #{d.name}", selected: d.id == work_item.deliverable_id } },
        name: "work_item[deliverable_id]",
        selected_value: work_item.deliverable_id,
        selected_label: work_item.deliverable && "#{work_item.deliverable.feature.name} / #{work_item.deliverable.name}",
        placeholder: "Select a deliverable"
      ) %>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block font-medium text-foreground mb-1" %>
    <%= form.text_field :title, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
  </div>
  <div>
    <%= form.label :description, class: "block font-medium text-foreground mb-1" %>
    <%= form.text_area :description, rows: 3, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :status, class: "block font-medium text-foreground mb-1" %>
      <%= form.select :status, Workspace::WorkItem::STATUSES.map { |s| [s.titleize, s] }, {}, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
    </div>
    <div>
      <%= form.label :due_date, class: "block font-medium text-foreground mb-1" %>
      <%= form.date_field :due_date, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
    </div>
  </div>

  <div>
    <p class="block font-medium text-foreground mb-1">Assignee</p>
    <%= render_combobox(
      assignees.map { |p| { value: p.id, name: p.full_name, selected: p.id == work_item.assignee_id } },
      name: "work_item[assignee_id]",
      selected_value: work_item.assignee_id,
      selected_label: work_item.assignee&.full_name,
      placeholder: "Assign to (optional)"
    ) %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :blocked, class: "rounded border-input" %>
    <%= form.label :blocked, "Blocked", class: "font-medium text-foreground" %>
  </div>

  <div>
    <%= form.label :blocked_reason, class: "block font-medium text-foreground mb-1" %>
    <%= form.text_area :blocked_reason, rows: 2, class: "w-full border border-input rounded-md px-4 py-2 bg-background" %>
  </div>

  <%= render_button work_item.persisted? ? "Save changes" : "Create work item", type: :submit %>
<% end %>
