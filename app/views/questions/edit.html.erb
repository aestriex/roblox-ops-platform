<%= turbo_frame_tag dom_id(@question) do %>
  <%= form_with model: @question, url: job_posting_section_question_path(@job_posting, @section, @question), method: :patch, class: "space-y-4 p-4 border border-border rounded-lg mb-4", data: { controller: "toggle-visibility", "toggle-visibility-shown-types-value": Question::OPTION_TYPES.to_json } do |form| %>
    <div>
      <%= form.label :label, "Question Text", class: "block font-medium text-foreground mb-1" %>
      <%= form.text_field :label, class: "w-full border border-input rounded-md px-4 py-2 bg-background focus:ring-2 focus:outline-none focus:ring-accent duration-100" %>
    </div>

    <div>
      <%= form.label :question_type, "Question Type", class: "block font-medium text-foreground mb-1" %>

      <%= form.select :question_type, Question::QUESTION_TYPES, {}, {
            class: "w-full border border-input rounded-md px-4 py-2 bg-background focus:ring-2 focus:outline-none focus:ring-accent duration-100",
            data: { action: "change->toggle-visibility#check", "toggle-visibility-target": "select" }
          } %>
    </div>

    <div
      data-toggle-visibility-target="optionsPanel"
      class="<%= "hidden" unless @question.has_options? %>"
    >
      <%= form.label :options, "Options (one per line)", class: "block font-medium text-foreground mb-1" %>
      <%= form.text_area :options, rows: 4, class: "w-full border border-input rounded-md px-4 py-2 bg-background focus:ring-2 focus:outline-none focus:ring-accent duration-100" %>
    </div>

    <div class="flex items-center gap-2">
      <%= hidden_field_tag "question[required]", "0", id: nil %>
      <%= render_checkbox(label: "Required", name: "question[required]", value: "1", checked: @question.required) %>
    </div>

    <div class="flex items-center gap-2">
      <%= render_button "Save Question", type: :submit %>
      <%= render_button "Cancel", as: :link, href: job_posting_section_question_path(@job_posting, @section, @question), variant: :outline, data: { turbo_frame: dom_id(@question) } %>
    </div>
  <% end %>
<% end %>
