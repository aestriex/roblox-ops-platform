<%= turbo_frame_tag dom_id(question), data: { id: question.id } do %>
  <div
    id="<%= dom_id(question) %>"
    class="mb-3 p-4 bg-muted rounded-lg flex items-start gap-3"
  >
    <%= lucide_icon "grip-vertical", class: "w-4 h-4 text-muted-foreground cursor-grab drag-handle mt-1" %>

    <div class="flex-1">
      <div class="flex items-center gap-2 mb-1">
        <%= render_tooltip do %>
          <% tooltip_trigger do %>
            <%= lucide_icon question.type_icon, class: "w-4 h-4 text-muted-foreground" %>
          <% end %>

          <% tooltip_content do %>
            <%= question.type_label %>
          <% end %>
        <% end %>

        <p class="font-medium text-foreground"><%= question.label %></p>

        <% if question.required %>
          <span class="text-xs text-destructive">*</span>
        <% end %>
      </div>

      <% case question.question_type %>
      <% when "short_text" %>
        <div class="h-8 w-full max-w-xs bg-background border border-input rounded-md"></div>
      <% when "long_text" %>
        <div class="h-16 w-full bg-background border border-input rounded-md"></div>
      <% when "file_upload" %>
        <div
          class="
            flex items-center justify-center gap-2 px-3 py-2 border
            border-dashed border-input rounded-md text-sm
            text-muted-foreground w-fit
          "
        >
          <%= lucide_icon "paperclip", class: "w-4 h-4" %> Click to upload
        </div>
      <% when "checkbox" %>
        <div class="space-y-1 text-sm text-muted-foreground">
          <% question.options_list.each do |option| %>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 border border-input rounded-sm"></div> <%= option %>
            </div>
          <% end %>
        </div>
      <% when "radio" %>
        <div class="space-y-1 text-sm text-muted-foreground">
          <% question.options_list.each do |option| %>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 border border-input rounded-full"></div> <%= option %>
            </div>
          <% end %>
        </div>
      <% when "dropdown" %>
        <div
          class="
            flex items-center justify-between px-3 py-2 border border-input
            rounded-md text-sm text-muted-foreground w-fit min-w-[160px]
          "
        >
          <%= question.options_list.first || "Select an option" %>
          <%= lucide_icon "chevron-down", class: "w-4 h-4" %>
        </div>
      <% when "email" %>
        <div class="h-8 w-full max-w-xs bg-background border border-input rounded-md"></div>
      <% when "link" %>
        <div class="h-8 w-full max-w-xs bg-background border border-input rounded-md"></div>
      <% end %>
    </div>

    <%= render_button as: :link, href: edit_job_posting_section_question_path(question.section.job_posting, question.section, question), variant: :ghost, draggable: false do %>
      <%= lucide_icon "pencil", class: "w-4 h-4" %>
    <% end %>
  </div>
<% end %>
